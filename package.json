{
  "name": "agent-unittest-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "AgentUnitTest v2 — VSCode 单元测试垂直对话 Agent（TS monorepo：agent-server + extension）",
  "workspaces": [
    "contracts",
    "agent-server",
    "extension"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "echo \"(placeholder) 暂无测试，M2 起随真工具补齐\" && exit 0",
    "smoke:llm": "npm run smoke:llm -w agent-server",
    "smoke:contracts": "npm run smoke:contracts -w agent-server",
    "smoke:ws": "npm run smoke:ws -w agent-server",
    "smoke:confirm": "npm run smoke:confirm -w agent-server",
    "smoke:store": "npm run smoke:store -w agent-server",
    "smoke:agent": "npm run smoke:agent -w agent-server",
    "dev": "npm run dev -w agent-server"
  }
}

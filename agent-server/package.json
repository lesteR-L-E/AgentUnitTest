    "@ai-sdk/openai": "^4.0.98",
    "ai": "^7.0.146",
    "dotenv": "^18.0.8",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",

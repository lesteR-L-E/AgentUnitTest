# 复制为 .env 后填写（.env 已被 gitignore，绝不入库）
# 三个 provider 至少填一个；可直接从旧仓库 AgentUnitTest-backend/backend/.env 拷贝
#
# ⚠️ 通用规则：用不到的变量请【整行删除或注释掉】，不要留「KEY=」这种空值！
#    空字符串 ≠ 未设置：AI SDK 在 import 时会读取 OPENAI_BASE_URL 等环境变量，
#    空值会直接抛 "baseURL must be a non-empty string"。

# DeepSeek（走 OpenAI 兼容协议，冒烟脚本优先使用）
DEEPSEEK_API_KEY=

# OpenAI
OPENAI_API_KEY=

# 可选：代理/兼容网关地址 —— 默认注释掉，仅在使用代理时取消注释并填写完整地址
# OPENAI_BASE_URL=https://your-proxy.example.com/v1

# Anthropic
ANTHROPIC_API_KEY=

# 服务端口（默认 8765，插件启动后端时会传入实际端口）
PORT=8765
